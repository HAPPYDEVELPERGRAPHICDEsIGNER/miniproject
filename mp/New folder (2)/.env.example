# ==============================================================================
# AI-Powered Smart Learning & Coding Platform - Environment Configuration
# Copy this file to '.env' to configure your local or production environment.
# ==============================================================================

# Application Environment
APP_NAME="SmartEdu AI Learning Platform"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Security & JWT Authentication
# IMPORTANT: Generate a strong random key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=college-smartedu-secret-key-change-in-production-2026-secure
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local development default: SQLite with WAL mode.
# Production recommendation: postgresql+psycopg2://user:password@localhost:5432/smartedu_db
DATABASE_URL=sqlite:///./database/platform.db

# ------------------------------------------------------------------------------
# 1. AI ASSISTANT CONFIGURATION
# ------------------------------------------------------------------------------
# Choose AI Provider: 'gemini' or 'openai' (or leave blank to use intelligent offline tutor)
AI_PROVIDER=gemini

# Google Gemini API Configuration (Recommended free tier for education)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API Configuration (Alternative provider)
# Get an API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 2. CODE EXECUTION (JUDGE0) CONFIGURATION
# ------------------------------------------------------------------------------
# Real multi-language code execution service (Judge0)
# RapidAPI Judge0 URL: https://judge0-ce.p.rapidapi.com
# Free tier key at: https://rapidapi.com/judge0-official/api/judge0-ce
# Or Self-Hosted Open-Source Judge0 URL: http://localhost:2358
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ------------------------------------------------------------------------------
# 3. INITIAL ADMIN SEED ACCOUNT
# ------------------------------------------------------------------------------
ADMIN_INITIAL_EMAIL=admin@smartedu.edu
ADMIN_INITIAL_PASSWORD=Admin@SecurePass2026
